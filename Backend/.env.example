# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express API listens on
PORT=5000

# Origin allowed to call this API (your Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# OpenAI API key - required for AI explanation / tutor / comparison features.
# Get one at https://platform.openai.com/api-keys
# Leave blank to run the app WITHOUT AI features (algorithms still work fully).
OPENAI_API_KEY=

# Optional: override the default model (gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

NODE_ENV=development
